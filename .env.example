# Copy to .env.local for local development. .env.local is git-ignored.

# Only needed when adding premium blocks with the shadcn CLI:
#   pnpm shadcn add @shadcnblocks/<block-name>
# Never commit the key, never prefix it with NEXT_PUBLIC_, never paste it into source files.
SHADCNBLOCKS_API_KEY=

# The API (docs/api.md): /api on the app's own origin in production (D2), or an absolute URL without a
# trailing slash. Required for production builds; `pnpm dev` falls back to http://localhost:8000/api.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
